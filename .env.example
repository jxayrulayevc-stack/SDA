# Скопируйте этот файл в каталог данных на сервере и заполните вручную.
# НИКОГДА не коммитьте заполненный .env и не публикуйте значения из него.

# Токен бота, полученный у @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую. Остальные пользователи игнорируются.
ADMIN_IDS=

# Ключ Fernet: python scripts/generate_key.py (вывод НЕ коммитить)
ENCRYPTION_KEY=

# Время жизни сообщения с кодом, секунды
CODE_TTL_SECONDS=60

# --- Необязательные параметры (значения по умолчанию) ---
# Каталог данных (БД). На сервере: /home/ubuntu/steam-guard-bot-data
# DATA_DIR=data
# Путь к файлу .env (передаётся также через Environment= в systemd)
# ENV_FILE=.env
# Интервал синхронизации времени с Steam, секунды
# STEAM_TIME_SYNC_INTERVAL=3600
# Лимит запросов кодов: не более CODE_RATE_LIMIT за RATE_LIMIT_WINDOW секунд
# CODE_RATE_LIMIT=10
# RATE_LIMIT_WINDOW=60
# Максимальный размер загружаемого maFile, байт (100 КБ)
# MAX_UPLOAD_BYTES=102400
