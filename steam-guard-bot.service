[Unit]
Description=Steam Guard Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/steam-guard-bot
Environment=ENV_FILE=/home/ubuntu/steam-guard-bot-data/.env
Environment=DATA_DIR=/home/ubuntu/steam-guard-bot-data
ExecStart=/home/ubuntu/steam-guard-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=150M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/steam-guard-bot-data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=steam-guard-bot

[Install]
WantedBy=multi-user.target
